<footer class="relative bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-gray-300 overflow-hidden">
    <!-- Background decorative elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <!-- Animated gradient orbs -->
        <div class="absolute -top-40 -left-40 w-80 h-80 bg-green-500/10 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute -bottom-40 -right-40 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-green-400/5 rounded-full blur-3xl"></div>
        
        <!-- Grid pattern overlay -->
        <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
    </div>

    <!-- Main footer content -->
    <div class="relative z-10 pt-20 pb-8">
        <div class="container mx-auto px-6">
            <!-- Top section with logo and CTA -->
            <div class="text-center mb-16" data-aos="fade-up">
                <div class="flex flex-col items-center space-y-6">
                    <!-- Logo and brand -->
                    <div class="flex items-center space-x-4">
                        <img src="/assets/images/fgpy.png" alt="Logo Forestal Paraguay S.A." class="h-12 w-auto">
                        <div class="text-left">
                            <h3 class="text-2xl font-bold text-white">Forestal Paraguay</h3>
                            <p class="text-green-400 text-sm font-medium">Servicios Forestales Integrales</p>
                        </div>
                    </div>
                    
                    <!-- Call to action -->
                    <div class="max-w-2xl">
                        <h4 class="text-xl font-semibold text-white mb-3">¿Listo para optimizar sus operaciones forestales?</h4>
                        <p class="text-gray-400 mb-6">Contáctenos hoy mismo y descubra cómo podemos ayudarle a mejorar la eficiencia de su cadena de suministro.</p>
                        <a href="/componentes/contacto" 
                           class="inline-flex items-center gap-3 bg-gradient-to-r from-green-600 to-green-500 text-white px-8 py-4 rounded-2xl font-bold hover:shadow-2xl hover:shadow-green-500/25 transition-all duration-300 hover:-translate-y-1">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            <span>Contactar Ahora</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Grid content sections -->
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
                <!-- Company info -->
                <div class="space-y-6" data-aos="fade-up" data-aos-delay="100">
                    <div>
                        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                            <div class="w-1 h-6 bg-gradient-to-b from-green-400 to-green-600 rounded-full"></div>
                            Nuestra Empresa
                        </h3>
                        <p class="text-gray-400 leading-relaxed">{{ site.description }}</p>
                    </div>
                    
                    <!-- Quality badges -->
                    <div class="space-y-3">
                        <div class="flex items-center gap-3 text-sm">
                            <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                            <span class="text-gray-300">15+ años de experiencia</span>
                        </div>
                        <div class="flex items-center gap-3 text-sm">
                            <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                            <span class="text-gray-300">Equipos especializados</span>
                        </div>
                        <div class="flex items-center gap-3 text-sm">
                            <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                            <span class="text-gray-300">Soporte 24/7</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Navigation -->
                <div data-aos="fade-up" data-aos-delay="200">
                    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                        <div class="w-1 h-6 bg-gradient-to-b from-green-400 to-green-600 rounded-full"></div>
                        Navegación Rápida
                    </h3>
                    <ul class="space-y-3">
                        <li>
                            <a href="/" class="group flex items-center gap-3 text-gray-400 hover:text-green-400 transition-all duration-300">
                                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                                <span>Inicio</span>
                            </a>
                        </li>
                        <li>
                            <a href="/componentes/servicios" class="group flex items-center gap-3 text-gray-400 hover:text-green-400 transition-all duration-300">
                                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                                <span>Servicios</span>
                            </a>
                        </li>
                        <li>
                            <a href="/componentes/vision_y_mision" class="group flex items-center gap-3 text-gray-400 hover:text-green-400 transition-all duration-300">
                                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                                <span>Visión y Misión</span>
                            </a>
                        </li>
                        <li>
                            <a href="/componentes/contacto" class="group flex items-center gap-3 text-gray-400 hover:text-green-400 transition-all duration-300">
                                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                                <span>Contacto</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Contact info -->
                <div data-aos="fade-up" data-aos-delay="300">
                    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                        <div class="w-1 h-6 bg-gradient-to-b from-green-400 to-green-600 rounded-full"></div>
                        Información de Contacto
                    </h3>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <div class="w-10 h-10 bg-green-500/20 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-400 text-sm">Email</p>
                                <a href="mailto:{{ site.email }}" class="text-white hover:text-green-400 transition-colors duration-300 font-medium">{{ site.email }}</a>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="w-10 h-10 bg-green-500/20 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-400 text-sm">Teléfono</p>
                                <a href="https://wa.me/{{ site.phone | replace(' ', '') | replace('-', '') | replace('(', '') | replace(')', '') }}" 
                                    target="_blank" 
                                    class="text-white hover:text-green-400 transition-colors duration-300 font-medium">
                                    {{ site.phone }}
                                </a>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="w-10 h-10 bg-green-500/20 rounded-xl flex items-center justify-center flex-shrink-0 mt-1">
                                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-gray-400 text-sm">Ubicación</p>
                                <p class="text-white font-medium">{{ site.location }}</p>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- Social media and newsletter -->
                <div data-aos="fade-up" data-aos-delay="400">
                    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                        <div class="w-1 h-6 bg-gradient-to-b from-green-400 to-green-600 rounded-full"></div>
                        Conéctate con Nosotros
                    </h3>
                    
                    <!-- Social media -->
                    <div class="space-y-4 mb-6">
                        <p class="text-gray-400 text-sm">Síguenos en nuestras redes sociales</p>
                        <div class="flex space-x-3">
                            {% if site.social.instagram %}
                                <a href="{{ site.social.instagram }}" 
                                   class="group w-12 h-12 bg-gradient-to-br from-purple-500/20 to-pink-500/20 hover:from-purple-500/30 hover:to-pink-500/30 rounded-xl flex items-center justify-center transition-all duration-300 hover:-translate-y-1" 
                                   aria-label="Instagram">
                                    <i class="fab fa-instagram text-xl text-gray-400 group-hover:text-white transition-colors duration-300"></i>
                                </a>
                            {% endif %}
                            {% if site.social.whatsapp %}
                                <a href="{{ site.social.whatsapp }}" 
                                   class="group w-12 h-12 bg-gradient-to-br from-green-500/20 to-green-600/20 hover:from-green-500/30 hover:to-green-600/30 rounded-xl flex items-center justify-center transition-all duration-300 hover:-translate-y-1" 
                                   aria-label="WhatsApp">
                                    <i class="fab fa-whatsapp text-xl text-gray-400 group-hover:text-white transition-colors duration-300"></i>
                                </a>
                            {% endif %}
                            <!-- Additional social placeholder -->
                            <a href="#" 
                               class="group w-12 h-12 bg-gradient-to-br from-blue-500/20 to-blue-600/20 hover:from-blue-500/30 hover:to-blue-600/30 rounded-xl flex items-center justify-center transition-all duration-300 hover:-translate-y-1" 
                               aria-label="LinkedIn">
                                <i class="fab fa-linkedin text-xl text-gray-400 group-hover:text-white transition-colors duration-300"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Newsletter signup -->
                    <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-4">
                        <h4 class="text-white font-semibold mb-2">Mantente Informado</h4>
                        <p class="text-gray-400 text-xs mb-3">Recibe actualizaciones sobre nuestros servicios</p>
                        <div class="flex gap-2">
                            <input type="email" 
                                   placeholder="Tu email" 
                                   class="flex-1 bg-white/10 border border-white/20 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-green-400 transition-colors duration-300">
                            <button class="bg-green-500 hover:bg-green-400 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-300">
                                ✓
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom section -->
            <div class="border-t border-gray-700/50 pt-8" data-aos="fade-up" data-aos-delay="500">
                <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                    <!-- Copyright -->
                    <div class="text-center md:text-left">
                        <p class="text-gray-500">&copy; <span id="current-year"></span> {{ site.name }}. Todos los derechos reservados.</p>
                        <script>
                        document.getElementById('current-year').textContent = new Date().getFullYear();
                        </script>
                        <p class="text-gray-600 text-sm mt-1">Desarrollado con 💚 para el sector forestal</p>
                    </div>
                    
                    <!-- Additional links -->
                    <div class="flex items-center gap-6 text-sm">
                        <a href="#" class="text-gray-500 hover:text-green-400 transition-colors duration-300">Política de Privacidad</a>
                        <a href="#" class="text-gray-500 hover:text-green-400 transition-colors duration-300">Términos de Servicio</a>
                        <div class="flex items-center gap-2 text-gray-500">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                            <span class="text-xs">Hecho en Paraguay</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
/* Grid pattern for footer background */
.bg-grid-pattern {
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 20px 20px;
}

/* Custom animations for footer */
@keyframes float-slow {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-5px); }
}

.animate-float-slow {
    animation: float-slow 4s ease-in-out infinite;
}
</style>