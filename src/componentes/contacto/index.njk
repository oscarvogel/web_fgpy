  <script>
    function openMailClient(form) {
      const name = form.name.value.trim();
      const email = form.email.value.trim();
      const subject = encodeURIComponent(form.subject.value || 'Consulta desde el sitio web');
      const message = encodeURIComponent(`Nombre: ${name} Correo: ${email} ${form.message.value}`);
  
      const mailtoLink = `mailto:forestalparaguay@gmail.com?subject=${subject}&body=${message}`;
      window.location.href = mailtoLink;
      return false; // Evita envío real
    }
  </script>
  